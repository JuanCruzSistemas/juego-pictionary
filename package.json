{
  "name": "garabato",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:api": "npm run start:dev -w @garabato/api",
    "dev:web": "npm run start -w @garabato/web",
    "test": "npm test -w @garabato/api && npm run test:e2e -w @garabato/api && npm test -w @garabato/web -- --watch=false",
    "build": "npm run build -w @garabato/api && npm run build -w @garabato/web",
    "db:migrate": "npm run db:migrate -w @garabato/api",
    "db:seed": "npm run db:seed -w @garabato/api",
    "crear-sala": "npm run crear-sala -w @garabato/api --",
    "db:limpiar-salas": "npm run db:limpiar-salas -w @garabato/api"
  },
  "engines": {
    "node": ">=24"
  }
}
