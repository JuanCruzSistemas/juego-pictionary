{
  "name": "garabato",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:api": "npm run start:dev -w @garabato/api",
    "dev:web": "npm run start -w @garabato/web",
    "test": "npm test -w @garabato/api && npm run test:e2e -w @garabato/api",
    "build": "npm run build -w @garabato/api && npm run build -w @garabato/web"
  }
}
