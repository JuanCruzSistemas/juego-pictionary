# Copiar a apps/api/.env para desarrollo local.

# Postgres de docker-compose. En local no hay pooler: las dos apuntan al mismo lugar.
DATABASE_URL=postgresql://garabato:garabato@localhost:5432/garabato
DIRECT_URL=postgresql://garabato:garabato@localhost:5432/garabato

# Puerto de la API.
PORT=3000

# Origen del front permitido por CORS en producción. En local el front usa el proxy de ng serve.
WEB_ORIGIN=http://localhost:4200

# Base de los links que imprime `npm run crear-sala`. Para los celulares, usá la IP de la compu.
WEB_URL=http://localhost:4200
